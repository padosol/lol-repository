# ===========================================
# LOL Repository - local 프로파일 환경 변수
# ===========================================
# 사용법: 이 파일을 .env 로 복사한 뒤 값을 채운다
#   cp .env.example .env
# 앱은 .env 를 스스로 읽지 않는다. IntelliJ 실행 설정의 Environment variables(또는 EnvFile 플러그인)로 넣는다.
# 기본값은 docker/infra/compose.yml 로 띄운 인프라에 맞춰 두었다.
# ===========================================

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- Riot Games API (필수) ---
RIOT_API_KEY=
# 개발 키를 쓸 때만: Riot app 한도 (기본은 운영 키 한도 500:10,30000:600)
# RIOT_RATELIMIT_APPLIMITS=20:1,100:120

# --- PostgreSQL (docker/infra) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lol_local
DB_USERNAME=postgres
DB_PASSWORD=1234

# --- RabbitMQ (docker/infra, vhost /) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# --- Redis (docker/infra) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- 부하 테스트 (load-test) ---
# 랭킹 스케줄러 주기 실행(기동 1분 뒤, 그 뒤 2시간마다). 켜 두면 부하 중에 같은 Riot 한도를 쓴다
LOL_RANKING_SCHEDULER_ENABLED=false
# 갱신 시간 histogram. Grafana "서버 갱신 시간" 분위수가 이 값이 true 일 때만 나온다
MANAGEMENT_METRICS_DISTRIBUTION_PERCENTILESHISTOGRAM_LOL_RENEWAL_DURATION=true

# --- 선택 (주석을 풀면 기본값을 바꾼다) ---
# SERVER_PORT=8111
# INTERNAL_PORT=8112
# DB_POOL_MAX=15
# LOG_LEVEL_APP=INFO
